# Anthropic API key — required for chat integration tests and the Chat Planner.
# See setup.ps1 -Key to configure.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key — optional, enables GPT models in the Chat Planner.
# See setup.ps1 -OpenAIKey to configure.
OPENAI_API_KEY=sk-your-key-here

# Google Gemini API key — optional, enables Gemini models in the Chat Planner.
# See setup.ps1 -GeminiKey to configure.
GEMINI_API_KEY=your-key-here
